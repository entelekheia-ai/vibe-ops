{
  "type": "task",
  "answers": "What is being worked on right now?",
  "template": "./templates/task.md",
  "authoring": "./authoring.md",
  "migrations": "./migrations",
  "schema": {
    "carrier": "table",
    "required": [
      "Status",
      "Created",
      "Author",
      "Issue"
    ]
  },
  "lifecycle": {
    "chain": [
      "Planned",
      "In Progress",
      "Done"
    ],
    "active": "In Progress",
    "terminal": "Done"
  },
  "notes": "./lifecycle-notes.md",
  "numbered": true,
  "pad": 3,
  "depth": 1,
  "dirs": [
    "project/tasks",
    "tasks"
  ]
}
