{
  "id": "mirror",
  "version": "0.0.1",
  "summary": "What one place claims, another place must confirm",
  "gates": [
    {
      "gate": "template-heading-drift",
      "paths": [
        "**/*.md",
        ".agents/**/*.md"
      ],
      "options": {
        "migrations": "cli/packages/governance-plan/migrations",
        "templates": {
          "adr": "cli/packages/governance-adr/templates/adr.md",
          "log": "cli/packages/governance-log/templates/log.md",
          "plan": "cli/packages/governance-plan/templates/plan.md",
          "rfc": "cli/packages/governance-rfc/templates/rfc.md",
          "task": "cli/packages/governance-task/templates/task.md"
        }
      },
      "emits": true,
      "fixture": {
        "options": {
          "migrations": "<plugin>/migrations",
          "templates": {
            "plan": "<plugin>/templates/plan.md"
          }
        },
        "expect": [
          "template-heading-drift-named",
          "template-heading-drift-count"
        ],
        "files": {
          "migrations/plan-0.1-to-0.2.md": "# plan 0.1 → 0.2\n\n| Section | 0.1 | 0.2 |\n|---|---|---|\n| `## Progress` | step-level checklist | **dropped** |\n| Living sections | four | two |\n\n",
          "templates/plan.md": "---\nvibe-ops-template: plan@3\n---\n\n# Plan-NNN\n\n<!-- ===== LIVING SECTIONS ===== -->\n\n## Decision Log\n\n## Outcomes & Retrospective\n\n<!-- ===== END LIVING SECTIONS ===== -->\n\n",
          "rule.md": "### Plan (`project/plans/`)\n\nFour sections are living and are maintained while the work happens: `Progress` is one.\n\n"
        }
      }
    },
    {
      "gate": "fragment-parity",
      "paths": [
        "**/*.md"
      ],
      "emits": true,
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "links",
        "against": "markdown-link"
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-frontmatter",
      "paths": [
        ".agents/rules/*.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "frontmatter",
        "against": "check-frontmatter",
        "options": {
          "schema": "rule"
        }
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-skill-frontmatter",
      "paths": [
        "<plugin>/skills/*/SKILL.md",
        ".agents/skills/*/SKILL.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "skill-frontmatter",
        "against": "check-frontmatter",
        "options": {
          "schema": "skill"
        }
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-memory-slug",
      "paths": [
        "AGENTS.md",
        "**/AGENTS.md",
        "**/CLAUDE.md",
        "**/README.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "memory-slugs",
        "against": "classification",
        "options": {
          "level": "internal",
          "rule": "memory-slug",
          "subject": "a pointer to a note nobody else holds",
          "forbid": [
            "\\[\\[[a-z0-9][a-z0-9_-]*\\]\\]"
          ]
        }
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-machine-paths",
      "paths": [
        "**/*.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "machine-paths",
        "against": "classification",
        "options": {
          "level": "confidential",
          "rule": "file-path",
          "subject": "an absolute path from someone's machine",
          "forbid": [
            "(?:/Users/|/home/|[Cc]:[\\\\/]+Users[\\\\/]+)[A-Za-z0-9][^\\s\"'`)]*"
          ]
        }
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-template-attribution",
      "paths": [
        "<plugin>/skills/*/templates/**/*.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "template-attribution",
        "against": "classification",
        "options": {
          "level": "confidential",
          "rule": "template-attribution",
          "subject": "an attribution a target repository never made",
          "forbid": [
            "Copyright \\(c\\) [0-9]{4}"
          ]
        }
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-bridge",
      "paths": [
        ".claude/**"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "bridge",
        "against": "bridge"
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-budget",
      "paths": [
        "AGENTS.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "budget",
        "against": "budget"
      }
    },
    {
      "gate": "fragment-parity",
      "label": "fragment-parity-dogfooding-drift",
      "paths": [
        "GOVERNANCE.md",
        "cli/packages/governance-*/templates/*.md",
        ".agents/rules/governance.md"
      ],
      "options": {
        "runner": "cli/packages/module-check/sh/check-agents-md.sh",
        "fragment": "dogfooding-drift",
        "against": "mirror",
        "options": {
          "compare": "text",
          "ignore": [
            "copyright"
          ],
          "rule": "dogfooding-drift",
          "subject": "this repository's own copy and the copy it ships",
          "pairs": [
            [
              "cli/packages/governance-plan/templates/plan.md",
              "<plugin>/skills/setup/templates/project/templates/plan.md"
            ],
            [
              "cli/packages/governance-task/templates/task.md",
              "<plugin>/skills/setup/templates/project/templates/task.md"
            ],
            [
              "cli/packages/governance-adr/templates/adr.md",
              "<plugin>/skills/setup/templates/project/templates/adr.md"
            ],
            [
              "cli/packages/governance-rfc/templates/rfc.md",
              "<plugin>/skills/setup/templates/project/templates/rfc.md"
            ],
            [
              "cli/packages/governance-log/templates/log.md",
              "<plugin>/skills/setup/templates/project/templates/log.md"
            ],
            [
              ".agents/rules/governance.md",
              "<plugin>/skills/setup/templates/agents/rules/governance.md"
            ],
            [
              "GOVERNANCE.md",
              "<plugin>/skills/setup/templates/root/GOVERNANCE.md"
            ]
          ]
        }
      }
    },
    {
      "gate": "mirror",
      "label": "fragment-parity-completeness",
      "options": {
        "compare": "group",
        "rule": "fragment-uncovered",
        "subject": "a shell fragment with neither a fragment-parity entry nor a declared exemption",
        "left": {
          "scan": "id=\"([a-z-]+)\"",
          "in": [
            "cli/packages/module-check/sh/checks/10-budget.sh",
            "cli/packages/module-check/sh/checks/15-manifest-sync.sh",
            "cli/packages/module-check/sh/checks/20-links.sh",
            "cli/packages/module-check/sh/checks/25-hooks-registration.sh",
            "cli/packages/module-check/sh/checks/27-nudge-behaviour.sh",
            "cli/packages/module-check/sh/checks/30-bridge.sh",
            "cli/packages/module-check/sh/checks/35-dogfooding-drift.sh",
            "cli/packages/module-check/sh/checks/40-frontmatter.sh",
            "cli/packages/module-check/sh/checks/45-skill-frontmatter.sh",
            "cli/packages/module-check/sh/checks/50-private-names.sh",
            "cli/packages/module-check/sh/checks/52-machine-paths.sh",
            "cli/packages/module-check/sh/checks/55-references-completeness.sh",
            "cli/packages/module-check/sh/checks/60-memory-slugs.sh",
            "cli/packages/module-check/sh/checks/70-plugin-root-paths.sh",
            "cli/packages/module-check/sh/checks/80-template-attribution.sh",
            "cli/packages/module-check/sh/checks/90-license-texts.sh",
            "cli/packages/module-check/sh/checks/95-command-references.sh"
          ]
        },
        "right": {
          "scan": "\"(?:fragment|exempt)\": \"([a-z-]+)\"",
          "in": [
            "cli/packages/ops-mirror/ops.json"
          ]
        },
        "exemptions": [
          { "exempt": "private-names", "reason": "never names a file — the deny-list value must not be echoed anywhere, including in a comparison's evidence" },
          { "exempt": "hooks-registration", "reason": "mirror group entry — file is the prose subject, never a path (gates/src/mirror/index.ts)" },
          { "exempt": "references-completeness", "reason": "mirror group entry, same reason" },
          { "exempt": "plugin-root-paths", "reason": "mirror scan entry, same reason" },
          { "exempt": "command-references", "reason": "mirror scan entry, same reason" },
          { "exempt": "license-texts", "reason": "mirror rows entry — file is always SOURCES.tsv, never the licence that failed" },
          { "exempt": "manifest-sync", "reason": "Plan-038 Track 1 — the shell fail() carries no <file>: prefix in any of its four comparisons" },
          { "exempt": "nudge-behaviour", "reason": "Plan-038 Track 1 — its port is a node test, not a loadable gate" }
        ]
      }
    },
    {
      "gate": "mirror",
      "label": "manifest-version",
      "emits": true,
      "options": {
        "compare": "text",
        "rule": "manifest-version-drift",
        "subject": "the plugin version, in plugin.json and its marketplace listing",
        "left": {
          "json": "version",
          "in": "<plugin>/.claude-plugin/plugin.json"
        },
        "right": {
          "jsonSelect": {
            "array": "plugins",
            "match": {
              "field": "name",
              "from": "<plugin>/.claude-plugin/plugin.json",
              "json": "name"
            },
            "field": "version"
          },
          "in": ".claude-plugin/marketplace.json"
        }
      },
      "fixture": {
        "expect": [
          "manifest-version-drift"
        ],
        "files": {
          ".claude-plugin/plugin.json": "{\"name\": \"thing\", \"version\": \"0.1.0\"}",
          ".claude-plugin/marketplace.json": "{\"plugins\": [{\"name\": \"thing\", \"version\": \"0.2.0\"}]}"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "manifest-description",
      "options": {
        "compare": "text",
        "rule": "manifest-description-drift",
        "subject": "the plugin description, in plugin.json and its marketplace listing",
        "left": {
          "json": "description",
          "in": "<plugin>/.claude-plugin/plugin.json"
        },
        "right": {
          "jsonSelect": {
            "array": "plugins",
            "match": {
              "field": "name",
              "from": "<plugin>/.claude-plugin/plugin.json",
              "json": "name"
            },
            "field": "description"
          },
          "in": ".claude-plugin/marketplace.json"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "manifest-keywords",
      "options": {
        "compare": "group",
        "bothWays": true,
        "rule": "manifest-keywords-drift",
        "subject": "the plugin keywords, in plugin.json and its marketplace listing",
        "left": {
          "json": "keywords",
          "in": "<plugin>/.claude-plugin/plugin.json"
        },
        "right": {
          "jsonSelect": {
            "array": "plugins",
            "match": {
              "field": "name",
              "from": "<plugin>/.claude-plugin/plugin.json",
              "json": "name"
            },
            "field": "keywords"
          },
          "in": ".claude-plugin/marketplace.json"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "manifest-changelog-version",
      "emits": true,
      "options": {
        "compare": "text",
        "rule": "manifest-changelog-drift",
        "subject": "the plugin version and CHANGELOG.md's newest released heading",
        "left": {
          "json": "version",
          "in": "<plugin>/.claude-plugin/plugin.json"
        },
        "right": {
          "capture": "^## \\[(?!Unreleased)([^\\]]+)\\]",
          "in": "CHANGELOG.md",
          "optional": true
        }
      },
      "fixture": {
        "expect": [
          "manifest-changelog-drift"
        ],
        "files": {
          ".claude-plugin/plugin.json": "{\"version\": \"0.2.0\"}",
          "CHANGELOG.md": "# Changelog\n\n## [Unreleased]\n\n## [0.1.0] — 2026-01-01\n"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "dogfooding-drift",
      "options": {
        "compare": "text",
        "ignore": [
          "copyright"
        ],
        "subject": "this repository's copy and the copy it ships",
        "rule": "dogfooding-drift",
        "pairs": [
          [
            "cli/packages/governance-plan/templates/plan.md",
            "<plugin>/skills/setup/templates/project/templates/plan.md"
          ],
          [
            "cli/packages/governance-task/templates/task.md",
            "<plugin>/skills/setup/templates/project/templates/task.md"
          ],
          [
            "cli/packages/governance-adr/templates/adr.md",
            "<plugin>/skills/setup/templates/project/templates/adr.md"
          ],
          [
            "cli/packages/governance-rfc/templates/rfc.md",
            "<plugin>/skills/setup/templates/project/templates/rfc.md"
          ],
          [
            "cli/packages/governance-log/templates/log.md",
            "<plugin>/skills/setup/templates/project/templates/log.md"
          ],
          [
            ".agents/rules/governance.md",
            "<plugin>/skills/setup/templates/agents/rules/governance.md"
          ],
          [
            "GOVERNANCE.md",
            "<plugin>/skills/setup/templates/root/GOVERNANCE.md"
          ]
        ]
      },
      "fixture": {
        "expect": [
          "dogfooding-drift"
        ],
        "files": {
          "GOVERNANCE.md": "# G\n\nown\n",
          "skills/setup/templates/project/GOVERNANCE.md": "# G\n\nshipped, edited\n"
        },
        "options": {
          "compare": "text",
          "ignore": [
            "copyright"
          ],
          "rule": "dogfooding-drift",
          "subject": "this repository's copy and the copy it ships",
          "pairs": [
            [
              "GOVERNANCE.md",
              "skills/setup/templates/project/GOVERNANCE.md"
            ]
          ]
        }
      }
    },
    {
      "gate": "mirror",
      "label": "license-text",
      "emits": true,
      "options": {
        "compare": "sha",
        "rule": "license-text",
        "subject": "a licence this plugin hands out",
        "rows": {
          "file": "cli/packages/governance-license/templates/SOURCES.tsv",
          "format": "tsv"
        },
        "left": {
          "file": "cli/packages/governance-license/templates/${0}.txt"
        },
        "right": {
          "column": 2
        }
      }
    },
    {
      "gate": "mirror",
      "label": "hooks-registration",
      "options": {
        "compare": "group",
        "bothWays": true,
        "rule": "hooks-registration",
        "subject": "the hook registration and the scripts on disk",
        "left": {
          "scan": "\\$\\{CLAUDE_PLUGIN_ROOT\\}/hooks/([A-Za-z0-9_.-]+)",
          "in": [
            "<plugin>/hooks/hooks.json"
          ]
        },
        "right": {
          "entries": "<plugin>/hooks",
          "kind": "file",
          "matching": "\\.sh$"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "authoring-completeness",
      "options": {
        "compare": "group",
        "rule": "authoring-missing",
        "subject": "the authoring rules each governance package owes",
        "left": {
          "entries": "cli/packages",
          "kind": "dir",
          "matching": "^governance-(adr|rfc|plan|task)$"
        },
        "right": {
          "resolving": "cli/packages/${0}/authoring.md"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "plugin-root-path",
      "emits": true,
      "paths": [
        "**/*.md"
      ],
      "options": {
        "compare": "group",
        "rule": "plugin-root-path",
        "subject": "a path this plugin ships",
        "left": {
          "scan": "\\$\\{CLAUDE_PLUGIN_ROOT\\}/([A-Za-z0-9_./-]+)",
          "in": [
            "**/*.md"
          ]
        },
        "right": {
          "resolving": "<plugin>/${0}"
        }
      }
    },
    {
      "gate": "mirror",
      "label": "command-reference",
      "paths": [
        "README.md",
        "<plugin>/skills/**/*.md",
        "<plugin>/agents/*.md"
      ],
      "options": {
        "compare": "group",
        "rule": "command-reference",
        "subject": "a command this plugin exposes",
        "left": {
          "scan": "vibe-ops:([A-Za-z0-9_-]+)",
          "in": [
            "README.md",
            "<plugin>/skills/**/*.md",
            "<plugin>/agents/*.md"
          ]
        },
        "right": {
          "resolving": [
            "<plugin>/skills/${0}",
            "<plugin>/agents/${0}.md"
          ]
        }
      }
    }
  ]
}
