{
  "name": "@entelekheia/vibe-ops-gates",
  "version": "0.0.1",
  "description": "Detectors for the agents-md ops, ported from cli/packages/module-check/sh/checks/ — TypeScript, one folder per gate",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    "./*": { "types": "./dist/*/index.d.ts", "default": "./dist/*/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=22.18" },
  "dependencies": { "@entelekheia/vibe-ops-core": "^0.0.1" },
  "devDependencies": { "@types/node": "^26.1.1", "typescript": "^7.0.2" }
}
