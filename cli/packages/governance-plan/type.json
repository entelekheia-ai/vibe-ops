{
  "type": "plan",
  "template": "./templates/plan.md",
  "authoring": "./authoring.md",
  "migrations": "./migrations",
  "schema": {
    "carrier": "table",
    "required": [
      "Status",
      "Created",
      "Author"
    ]
  },
  "lifecycle": {
    "chain": ["Backlog", "In Progress", "Shipped"],
    "active": "In Progress",
    "terminal": "Shipped",
    "living": ["Decision Log", "Outcomes & Retrospective"],
    "archive": "shipped"
  },
  "numbered": true,
  "pad": 3,
  "depth": 2,
  "dirs": [
    "project/plans",
    "plans",
    "docs/plans"
  ]
}
