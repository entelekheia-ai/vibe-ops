{
  "name": "@entelekheia/vibe-ops-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The CLI-internal harness module (no governance of its own): repo shape, promulgation, the applied-version comparison \u2014 and the BASE half of the ownership boundary",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entelekheia-ai/vibe-ops.git",
    "directory": "cli/packages/harness"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ownership.json",
    "policy",
    "scaffold"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@entelekheia/vibe-ops-agents-md": "^0.1.0",
    "@entelekheia/vibe-ops-core": "^0.1.0",
    "@entelekheia/vibe-ops-gates": "^0.1.0",
    "@entelekheia/vibe-ops-governance": "^0.1.0",
    "@entelekheia/vibe-ops-module-check": "^0.1.0",
    "@entelekheia/governance-base": "^0.1.0",
    "@entelekheia/vibe-ops-for-vibe-ops": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
