{
  "type": "adr",
  "title": "ADR",
  "answers": "We decided X, because Y",
  "template": "./templates/adr.md",
  "authoring": "./authoring.md",
  "migrations": "./migrations",
  "schema": {
    "carrier": "table",
    "required": [
      "Status",
      "Date",
      "Deciders"
    ]
  },
  "lifecycle": {
    "chain": [
      "Proposed",
      "Accepted"
    ],
    "active": "Proposed",
    "terminal": "Accepted",
    "branches": [
      {
        "from": "Accepted",
        "status": "Deprecated"
      },
      {
        "from": "Accepted",
        "status": "Superseded"
      }
    ],
    "immutableFrom": "Accepted"
  },
  "notes": "./lifecycle-notes.md",
  "numbered": true,
  "pad": 4,
  "depth": 1,
  "dirs": [
    "project/adr",
    "adr",
    "docs/adr"
  ]
}
