{
  "adr": {
    "version": 2,
    "template": "templates/adr.md",
    "authoring": "references/records/adr.md",
    "migrations": "skills/migrate/migrations",
    "schema": {
      "carrier": "table",
      "required": [
        "Status",
        "Date",
        "Deciders"
      ]
    },
    "numbered": true,
    "pad": 4,
    "depth": 1,
    "dirs": [
      "project/adr",
      "adr",
      "docs/adr"
    ]
  },
  "log": {
    "version": 2,
    "template": "templates/log.md",
    "authoring": "references/records/log.md",
    "migrations": "skills/migrate/migrations",
    "schema": {
      "carrier": "frontmatter",
      "required": [
        "name",
        "description",
        "kind",
        "path",
        "attempted",
        "source"
      ]
    },
    "numbered": false,
    "pad": 3,
    "depth": 1,
    "dirs": [
      "project/log"
    ]
  },
  "plan": {
    "version": 3,
    "template": "templates/plan.md",
    "authoring": "references/records/plan.md",
    "migrations": "skills/migrate/migrations",
    "schema": {
      "carrier": "table",
      "required": [
        "Status",
        "Created",
        "Author"
      ]
    },
    "numbered": true,
    "pad": 3,
    "depth": 2,
    "dirs": [
      "project/plans",
      "plans",
      "docs/plans"
    ]
  },
  "rfc": {
    "version": 2,
    "template": "templates/rfc.md",
    "authoring": "references/records/rfc.md",
    "migrations": "skills/migrate/migrations",
    "schema": {
      "carrier": "table",
      "required": [
        "Status",
        "Created",
        "Author"
      ]
    },
    "numbered": true,
    "pad": 4,
    "depth": 2,
    "dirs": [
      "project/rfc",
      "project/rfcs",
      "rfc",
      "rfcs",
      "docs/rfc"
    ]
  },
  "task": {
    "version": 3,
    "template": "templates/task.md",
    "authoring": "references/records/task.md",
    "migrations": "skills/migrate/migrations",
    "schema": {
      "carrier": "table",
      "required": [
        "Status",
        "Created",
        "Author",
        "Issue"
      ]
    },
    "numbered": true,
    "pad": 3,
    "depth": 1,
    "dirs": [
      "project/tasks",
      "tasks"
    ]
  }
}
